# Copy this file to .env and add your own Mapbox public access token.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token
# Set only after enabling permanent Geocoding API storage for this Mapbox account.
VITE_MAPBOX_PERMANENT_GEOCODING=false

# Optional when your API is hosted elsewhere.
VITE_API_URL=http://localhost:8000
